# ============================================================
# L-Rac Notion Blog — Vercel 环境变量示例
# ============================================================
# 必填：你的 Notion 数据库/页面 ID。
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：站点基础信息
NEXT_PUBLIC_AUTHOR=L-Rac
NEXT_PUBLIC_BIO=写代码、设计与生活的小浣熊。保持好奇，也保持自己的节奏。
NEXT_PUBLIC_LINK=https://your-domain.example
NEXT_PUBLIC_LANG=zh-CN
NEXT_PUBLIC_APPEARANCE=auto
NEXT_PUBLIC_KEYWORD=L-Rac,博客,Notion,技术,设计,生活,数字花园

# 内容更新缓存时间（秒）
NEXT_PUBLIC_REVALIDATE_SECOND=60

# 可选：评论（任选其一配置即可）
# NEXT_PUBLIC_COMMENT_GISCUS_REPO=owner/repo
# NEXT_PUBLIC_COMMENT_GISCUS_REPO_ID=
# NEXT_PUBLIC_COMMENT_GISCUS_CATEGORY=
# NEXT_PUBLIC_COMMENT_GISCUS_CATEGORY_ID=
# NEXT_PUBLIC_WALINE_SERVER_URL=
# NEXT_PUBLIC_COMMENT_ENV_ID=

# 可选：统计
# NEXT_PUBLIC_ANALYTICS_VERCEL=true
# NEXT_PUBLIC_ANALYTICS_GOOGLE_ID=G-XXXXXXXXXX

# 可选：备案
# NEXT_PUBLIC_BEI_AN=
# NEXT_PUBLIC_BEI_AN_GONGAN=
